{"attributes":{"from_version":"v18","guidance":["All feed-related entities are removed from the API. Feeds have been deprecated for some time, replaced with assets. Removed entities and their associated services: AdGroupExtensionSetting AdGroupFeed CampaignExtensionSetting CampaignFeed CustomerExtensionSetting CustomerFeed ExtensionFeedItem Feed FeedItem FeedItemSet FeedItemSetLink FeedItemTarget FeedMapping Removed enums: FeedOrigin PlaceholderType Removed fields: ChangeEvent.{feed,feed_item,feed_origin} ChangeEvent.ChangedResource.{feed,feed_item,campaign_feed,ad_group_feed} ChangeStatus.{feed,feed_item,ad_group_feed,campaign_feed,feed_origin} Campaign.DynamicSearchAdsSetting.feeds LocationGroupInfo.feed Segments.placeholder_type Removed views: FeedPlaceholderView"],"to_version":"v19","topic":"API-wide"},"family":"docs","kind":"upgrade_guidance","retrieved_at":"2026-09-04T00:00:00Z","sha256":"c929e227ef31311b8b179a6445cff8c4769290f54b77a1b3b2adb15a341ae1e2","source_url":"https://web.archive.org/web/20250827000000id_/https://developers.google.com/google-ads/api/docs/upgrade","subject":"docs.upgrade_entry.9a2b7555046538afba5d26bb4e60417a6c637e7d30c6210ace9666e11833004c","version":"v19"}
{"attributes":{"from_version":"v18","guidance":["Submessage types AudienceInsightsAttribute , AudienceInsightsTopic , AudienceInsightsEntity , AudienceInsightsCategory , AudienceInsightsDynamicLineup , AudienceInsightsAttributeMetadata , YouTubeChannelAttributeMetadata , DynamicLineupAttributeMetadata , LocationAttributeMetadata , and UserInterestAttributeMetadata have been migrated out of the \"resources\" folder into the \"common\" folder so that they can be reused with the ContentCreatorInsightsService . These types work the same way, but you may need to import them from a different location, depending on your implementation."],"to_version":"v19","topic":"AudienceInsightsService"},"family":"docs","kind":"upgrade_guidance","retrieved_at":"2026-09-04T00:00:00Z","sha256":"c929e227ef31311b8b179a6445cff8c4769290f54b77a1b3b2adb15a341ae1e2","source_url":"https://web.archive.org/web/20250827000000id_/https://developers.google.com/google-ads/api/docs/upgrade","subject":"docs.upgrade_entry.d214dcf1b21daef9f4db7e582c86f4acb8affc9f653bb27a6b9aeecc02e45cdc","version":"v19"}
