{"attributes":{"from_version":"v18","guidance":["When specifying the Campaign.asset_automation_settings or AdGroupAd.ad_group_ad_asset_automation_settings , omitting a setting for AssetAutomationType.GENERATE_SHORTER_YOUTUBE_VIDEOS for the DemandGenVideoResponsiveAdInfo ad type will result in being opted in for this feature. Previously, when omitting this setting, they were opted out."],"to_version":"v19","topic":"DemandGenVideoResponsiveAdInfo"},"family":"docs","kind":"upgrade_guidance","retrieved_at":"2026-09-04T00:00:00Z","sha256":"c929e227ef31311b8b179a6445cff8c4769290f54b77a1b3b2adb15a341ae1e2","source_url":"https://web.archive.org/web/20250827000000id_/https://developers.google.com/google-ads/api/docs/upgrade","subject":"docs.upgrade_entry.78c9db073b32d46d286a1e7a05ab42d76318c139ced760951d5c7e6335c0b426","version":"v19"}
